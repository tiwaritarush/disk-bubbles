<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:automation="clr-namespace:System.Windows.Automation;assembly=PresentationCore">
  <ControlTemplate x:Key="VolumeMeter" TargetType="ProgressBar">
    <Border CornerRadius="2" Background="{TemplateBinding Background}">
      <Grid x:Name="PART_Track">
        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="2" />
      </Grid>
    </Border>
  </ControlTemplate>

  <ControlTemplate x:Key="ScanMeter" TargetType="ProgressBar">
    <Border Background="{TemplateBinding Background}" CornerRadius="3">
      <Grid ClipToBounds="True">
        <Border x:Name="ScanMarker" Background="{TemplateBinding Foreground}" Width="82" HorizontalAlignment="Left" CornerRadius="3">
          
          <Border.RenderTransform>
            <TranslateTransform x:Name="ScanOffset" X="105" />
          </Border.RenderTransform>
        </Border>
      </Grid>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsIndeterminate" Value="True">
        <Trigger.EnterActions>
          <BeginStoryboard x:Name="Sweep">
            <Storyboard RepeatBehavior="Forever">
              <DoubleAnimation Storyboard.TargetName="ScanOffset" Storyboard.TargetProperty="X"
                               From="-82" To="288" Duration="0:0:1.65" />
            </Storyboard>
          </BeginStoryboard>
        </Trigger.EnterActions>
        <Trigger.ExitActions>
          <RemoveStoryboard BeginStoryboardName="Sweep" />
        </Trigger.ExitActions>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="ToolTip">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Background="{DynamicResource TooltipFill}" BorderBrush="{DynamicResource TooltipEdge}" BorderThickness="1" CornerRadius="9" Padding="12,9">
            <ContentPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Background" Value="{DynamicResource Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid>
            <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5"
                    Tag="{DynamicResource {x:Static SystemParameters.ClientAreaAnimationKey}}">
              <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
            </Border>
            <Border x:Name="FocusRing" Margin="-3" CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Accent}"
                    Visibility="Collapsed" IsHitTestVisible="False" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Opacity" Value="0.86" />
            </Trigger>
            <MultiDataTrigger>
              <MultiDataTrigger.Conditions>
                <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True" />
                <Condition Binding="{Binding Tag, ElementName=Frame}" Value="True" />
              </MultiDataTrigger.Conditions>
              <Setter TargetName="Frame" Property="RenderTransform">
                <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
              </Setter>
            </MultiDataTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.42" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="QuietButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="MinHeight" Value="27" />
    <Setter Property="Foreground" Value="{DynamicResource Muted}" />
  </Style>

  <Style TargetType="ContextMenu">
    <Setter Property="MinWidth" Value="108" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                  CornerRadius="7" Padding="4">
            <ItemsPresenter />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="4">
            <ContentPresenter ContentSource="Header" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource MenuHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollTrackButton" TargetType="RepeatButton">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Border Background="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Width" Value="9" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="Transparent" CornerRadius="5" Padding="2,0">
            <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageUpCommand" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="Grip" Background="{DynamicResource ScrollThumb}" CornerRadius="3" />
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Grip" Property="Background" Value="{DynamicResource ScrollHover}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource ScrollTrackButton}" Command="ScrollBar.PageDownCommand" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EntryRow" TargetType="ListBoxItem">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="Margin" Value="0,1,3,1" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="automation:AutomationProperties.Name">
      <Setter.Value>
        <Binding Path="AccessibleName" />
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Frame" Background="Transparent" Padding="{TemplateBinding Padding}" BorderBrush="Transparent"
                  BorderThickness="1" CornerRadius="8">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowHover}" />
            </Trigger>
            <Trigger Property="Tag" Value="Linked">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowLinked}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Frame" Property="Background" Value="{DynamicResource RowSelected}" />
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource RowSelectedEdge}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="EntryMark" TargetType="CheckBox">
    <Setter Property="Width" Value="27" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Border x:Name="Box" Width="14" Height="14" CornerRadius="4" BorderThickness="1"
                    BorderBrush="{DynamicResource Subtle}" Background="Transparent" />
            <Path x:Name="Check" Data="M 0,3 L 2.6,5.6 7,0.5" Stroke="{DynamicResource AccentInk}"
                  StrokeThickness="1.45" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="Collapsed"
                  HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Box" Property="BorderThickness" Value="2" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFill}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Box" Property="Opacity" Value="0.25" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="EntryTemplate">
    <Grid Margin="0,0,7,0" ToolTip="{Binding Name}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="27" />
        <ColumnDefinition Width="23" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="65" />
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="Mark" Style="{StaticResource EntryMark}" IsChecked="{Binding IsMarked, Mode=OneTime}"
                IsEnabled="{Binding CanMark, Mode=OneTime}" ToolTip="Mark for Recycle Bin review"
                automation:AutomationProperties.Name="{Binding Name, StringFormat='Mark {0} for Recycle Bin review'}" />
      <Border Grid.Column="1" Width="20" Height="26" HorizontalAlignment="Left">
        <Path x:Name="Glyph" Height="14" Width="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
              Stroke="{DynamicResource FileGlyph}" StrokeThickness="1.3" StrokeLineJoin="Round" Data="M 3,1 L 9,1 13,5 13,15 3,15 Z M 9,1 L 9,5 13,5" />
      </Border>
      <TextBlock Grid.Column="2" Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                 Foreground="{DynamicResource Ink}" FontSize="13" />
      <Border x:Name="SystemTag" Grid.Column="3" Margin="6,0,0,0" ToolTip="Critical Windows folder. Disk Bubbles protects it from recycling." Background="{DynamicResource BadgeFill}" BorderBrush="{DynamicResource BadgeEdge}"
              BorderThickness="1" CornerRadius="4" Padding="4,1" Visibility="Collapsed" VerticalAlignment="Center">
        <TextBlock Text="System" Foreground="{DynamicResource BadgeInk}" FontSize="10" FontWeight="SemiBold" />
      </Border>
      <TextBlock Grid.Column="4" Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="1,0,11,0" TextAlignment="Right" VerticalAlignment="Center" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding IsFolder}" Value="True">
        <Setter TargetName="Glyph" Property="Stroke" Value="{DynamicResource FolderGlyph}" />
        <Setter TargetName="Glyph" Property="Data" Value="M 1,4 L 1,13 16,13 16,5 9,5 7,3 1,3 Z" />
      </DataTrigger>
      <DataTrigger Binding="{Binding IsSystem}" Value="True">
        <Setter TargetName="SystemTag" Property="Visibility" Value="Visible" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>

  <Style x:Key="FilterInput" TargetType="TextBox">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="InputFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  CornerRadius="9" BorderThickness="1" Padding="2,0">
            <ScrollViewer x:Name="PART_ContentHost" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="InputFrame" Property="BorderBrush" Value="{DynamicResource Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="InputFrame" Property="Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <DataTemplate x:Key="AppRow">
    <Grid Margin="0,0,7,0" ToolTip="{Binding Location}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="28" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="91" />
      </Grid.ColumnDefinitions>
      <CheckBox x:Name="MarkApp" Style="{StaticResource EntryMark}" IsChecked="{Binding Marked, Mode=TwoWay}"
                IsEnabled="{Binding CanMark}" VerticalAlignment="Center" automation:AutomationProperties.Name="{Binding Name, StringFormat='Mark {0} for uninstall review'}" />
      <StackPanel Grid.Column="1">
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Kind}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" />
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" FontSize="12"
                 TextAlignment="Right" VerticalAlignment="Center" Margin="3,0,8,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="AppLeftover">
    <Grid Margin="4,0,7,0" ToolTip="{Binding Location}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="91" />
      </Grid.ColumnDefinitions>
      <StackPanel>
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Location}" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" FontSize="12"
                 TextAlignment="Right" VerticalAlignment="Center" Margin="3,0,8,0" />
    </Grid>
  </DataTemplate>

  <DataTemplate x:Key="RecycleEntry">
    <Grid Margin="0,2" ToolTip="{Binding Path}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <StackPanel Margin="0,0,12,0">
        <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Ink}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Path}" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="ReviewStatus" Text="{Binding ReviewStatus}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"
                   TextWrapping="Wrap" />
      </StackPanel>
      <TextBlock Grid.Column="1" Text="{Binding SizeLabel}" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Top" />
    </Grid>
    <DataTemplate.Triggers>
      <DataTrigger Binding="{Binding Ready}" Value="False">
        <Setter TargetName="ReviewStatus" Property="Foreground" Value="{DynamicResource Attention}" />
      </DataTrigger>
    </DataTemplate.Triggers>
  </DataTemplate>
</ResourceDictionary>
