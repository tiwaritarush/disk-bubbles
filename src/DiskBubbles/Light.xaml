  <SolidColorBrush x:Key="Attention" Color="#793D29" />
  <LinearGradientBrush x:Key="GlassEdge" StartPoint="0,0" EndPoint="0.8,1">
    <GradientStop Offset="0" Color="#FFFDF8" />
    <GradientStop Offset="0.45" Color="#DAD3C9" />
    <GradientStop Offset="1" Color="#C0B7AD" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Panel" StartPoint="0,0" EndPoint="0.72,1">
