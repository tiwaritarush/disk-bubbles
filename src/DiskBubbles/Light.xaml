    <GradientStop Offset="1" Color="#64FFFDFB" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="GlassClear" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#5CFFFEFA" />
    <GradientStop Offset="0.63" Color="#13FFFDFB" />
    <GradientStop Offset="1" Color="#44FFFDFB" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Raised" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Offset="0" Color="#FFFCF7" />
    <GradientStop Offset="1" Color="#ECE6DC" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="Header" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Offset="0" Color="#F6F1E9" />
    <GradientStop Offset="1" Color="#ECE6DC" />
